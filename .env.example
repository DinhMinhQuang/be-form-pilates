DATABASE_URL=postgres://postgres:postgres@localhost:5432/form_pilates
HARAVAN_WEBHOOK_SECRET=replace-with-haravan-webhook-secret
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/magic
# Development only: returns the raw token from POST /auth/magic-links.
EXPOSE_MAGIC_TOKEN=false

PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com

# Zalo OA: automatically refreshes tokens; rotated tokens persist in PostgreSQL.
ZNS_APP_ID=
ZNS_APP_SECRET=
ZNS_MAGIC_LINK_TEMPLATE_ID=
ZNS_ORDER_CONFIRMED_TEMPLATE_ID=
